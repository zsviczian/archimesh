{
  "name": "@archimesh/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts --local-demo",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test:db": "tsx src/db-check.ts && vitest run --config vitest.integration.config.ts",
    "model:cli": "tsx src/tools/cli.ts",
    "model:mcp": "tsx src/tools/mcp.ts"
  },
  "dependencies": {
    "@archimesh/contracts": "workspace:*",
    "@archimesh/core": "workspace:*",
    "@fastify/static": "11.0.0",
    "@fastify/swagger": "9.9.5",
    "@modelcontextprotocol/server": "2.4.0",
    "fastify": "5.12.8",
    "kysely": "0.28.20",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}

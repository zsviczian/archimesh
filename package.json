{
  "name": "archimesh",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @archimesh/contracts build && pnpm --parallel --filter @archimesh/server --filter @archimesh/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @archimesh/contracts build && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @archimesh/contracts build && pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @archimesh/server migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.7",
    "eslint": "10.16.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
